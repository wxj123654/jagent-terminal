+// `init_threaded` so host crates can run callbacks on the GPUI thread
+// (terminal pool ops) without reaching a JS-owned renderer instance.
+#[cfg(any(target_os = "windows", target_os = "linux", target_os = "freebsd"))]
+pub static HOST_UI_COMMANDS: std::sync::OnceLock<mpsc::UnboundedSender<UiCommand>> =
+    std::sync::OnceLock::new();
+
+// j-agent patch (e2e seam): whether the threaded host channel is live.
+// False under TestGpuixRenderer (no init_threaded) — callers fall back to
+// run_on_test_app.
+#[cfg(any(target_os = "windows", target_os = "linux", target_os = "freebsd"))]
+pub fn host_ui_commands_ready() -> bool {
+    HOST_UI_COMMANDS.get().is_some()
+}
+
+// j-agent patch: pub seam for host crates — run a closure on the GPUI thread
+// (window + AsyncApp in scope) and wait for its JSON result. Longer timeout
+// than recv_ui_response: PTY spawn can exceed 2s on Windows ConPTY.
+#[cfg(any(target_os = "windows", target_os = "linux", target_os = "freebsd"))]
+pub fn run_on_gpuix(
+    f: Box<
+        dyn FnOnce(
+                &mut gpui::AsyncApp,
+                gpui::WindowHandle<GpuixView>,
+            ) -> anyhow::Result<serde_json::Value>
+            + Send,
+    >,
+) -> anyhow::Result<serde_json::Value> {
+    let sender = HOST_UI_COMMANDS
+        .get()
+        .ok_or_else(|| anyhow::anyhow!("GPUI application is not initialized"))?;
+    let (response_sender, response_receiver) = sync_channel(1);
+    sender
+        .unbounded_send(UiCommand::RunHost {
+            f,
+            response: response_sender,
+        })
+        .map_err(|_| anyhow::anyhow!("The GPUI UI thread is not running"))?;
+    match response_receiver.recv_timeout(Duration::from_secs(30)) {
+        Ok(result) => result,
+        Err(RecvTimeoutError::Timeout) => Err(anyhow::anyhow!(
+            "Timed out after 30 seconds waiting for the GPUI host callback"
+        )),
+        Err(RecvTimeoutError::Disconnected) => Err(anyhow::anyhow!(
+            "The GPUI UI thread stopped during the host callback"
+        )),
+    }
+}
