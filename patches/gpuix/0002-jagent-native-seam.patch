+// j-agent patch (e2e seam): same contract as renderer::run_on_gpuix, but for
+// the test renderer — no threaded app exists (HOST_UI_COMMANDS is never
+// published), so host closures run directly on this thread's VisualTestState.
+// bun test is single-threaded and the JS caller thread owns the context, so a
+// direct call is equivalent to the GPUI-thread round trip. Returns Err when no
+// TestGpuixRenderer was created on this thread.
+pub fn run_on_test_app(
+    f: Box<
+        dyn FnOnce(&mut gpui::App) -> anyhow::Result<serde_json::Value> + Send,
+    >,
+) -> anyhow::Result<serde_json::Value> {
+    TEST_STATE.with(|cell| {
+        let mut borrow = cell.borrow_mut();
+        let state = borrow
+            .as_mut()
+            .ok_or_else(|| anyhow::anyhow!("TestGpuixRenderer not initialized on this thread"))?;
+        state.cx.update(|app| f(app))
+    })
+}
